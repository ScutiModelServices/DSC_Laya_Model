# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat loads it for a local run (it passes --dotenv and prints the variable names it loaded); a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
LAYA_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
LAYA_PORT=9120

# Compose only: copies of the service behind nginx.
LAYA_REPLICAS=1
# LAYA_MEM_LIMIT=4g

# Cap torch CPU threads (default: torch decides). Set to the CPU cores the container/host really gives you.
# Also changeable on the /admin/ page (saved; other replicas apply it on restart).
# LAYA_TORCH_THREADS=

# run.bat only (compose sets these itself): bind address, use only downloaded weights (1).
# LAYA_HOST=127.0.0.1
# LAYA_OFFLINE=0

# Tunables (update check hours, weight sync, answer cache, project model limits and folder, warm-up) are set on the
# /admin/ Settings card and saved in settings.json. These variables are only a starting value for run.bat; compose
# does not pass them. A saved value wins.
# LAYA_UPDATE_CHECK_HOURS=6
# LAYA_MAX_INFLIGHT=
# LAYA_SYNC_SECONDS=10
# LAYA_CACHE_SIZE=256
# LAYA_MAX_PROJECT_MODELS=2
# LAYA_PROJECT_WAIT_SECONDS=30
# LAYA_PROJECT_MODELS_DIR=
# LAYA_WARM=1

# Where project tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# LAYA_TOKENS_FILE=tokens.json
# LAYA_WEB_DIR=web
